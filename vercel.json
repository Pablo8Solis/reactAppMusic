{
  "rewrites": [
    {
      "source": "/search/:path*",
      "destination": "https://api.deezer.com/search/:path*"
    },
    {
      "source": "/artist/:path*",
      "destination": "https://api.deezer.com/artist/:path*"
    },
    {
      "source": "/album/:path*",
      "destination": "https://api.deezer.com/album/:path*"
    }
  ]
}
